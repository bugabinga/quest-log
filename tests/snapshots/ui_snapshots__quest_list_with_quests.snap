<div class="quests-list" id="quest-list" style="view-transition-name: quest-list;"><div class="quest-item completed" id="quest-1" data-quest-id="1" style="view-transition-name: quest-1;" data-view-transition="quest-morph"><div class="quest-content"><h3>Morning Meditation</h3><p>Begin your day with clarity</p><span class="exp-value">10 EXP</span></div><div class="quest-actions"><button class="toggle-btn completed" type="button" data-on:click__prevent="@post('/quests/toggle', { payload: { quest_id: 1 } })">✅ Quest Complete</button></div></div><div class="quest-item" id="quest-2" data-quest-id="2" style="view-transition-name: quest-2;" data-view-transition="quest-morph"><div class="quest-content"><h3>Defeat the Dragon</h3><p>Venture into the volcanic mountains</p><span class="exp-value">100 EXP</span></div><div class="quest-actions"><button class="toggle-btn" type="button" data-on:click__prevent="@post('/quests/toggle', { payload: { quest_id: 2 } })">⚔️ Mark Complete</button></div></div><div class="quest-item completed" id="quest-3" data-quest-id="3" style="view-transition-name: quest-3;" data-view-transition="quest-morph"><div class="quest-content"><h3>Past Quest Example</h3><p>A quest from the past</p><span class="exp-value">75 EXP</span></div><div class="quest-actions"><div class="completion-status quest-status--past completed">✅ Quest Complete</div></div></div></div>
