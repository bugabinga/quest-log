<details class="weekly-rewards" id="weekly-rewards" data-attr:open="$weeklyRewardsOpen ? 'true' : ''"><summary class="rewards-summary" data-on:click__prevent="$weeklyRewardsOpen = !$weeklyRewardsOpen"><span class="rewards-icon">🏆</span><span class="rewards-title">Weekly Rewards</span><span class="rewards-exp">300 EXP</span></summary><div class="rewards-list"><div class="reward-card" id="reward-1" data-reward-id="1"><div class="reward-header"><span class="reward-title">Ice Cream</span><span class="reward-exp">100 EXP</span></div><p class="reward-description">A sweet treat after hard work</p><div class="reward-progress"><div class="progress-bar reward-progress-bar"><div class="progress-fill" style="width: 50%"></div></div><span class="progress-text">50 / 100</span></div><div class="reward-actions"><button class="claim-btn locked" disabled>🔒 Available Sunday</button></div></div><div class="reward-card" id="reward-2" data-reward-id="2"><div class="reward-header"><span class="reward-title">Movie Night</span><span class="reward-exp">200 EXP</span></div><p class="reward-description">Pick any movie to watch</p><div class="reward-progress"><div class="progress-bar reward-progress-bar"><div class="progress-fill" style="width: 100%"></div></div><span class="progress-text">200 / 200</span></div><div class="reward-actions"><button class="claim-btn claimable" type="button" data-on:click__prevent="@post('/rewards/claim', { payload: { reward_id: 2 } })">⚔️ CLAIM REWARD! ⚔️</button></div></div><div class="reward-card" id="reward-3" data-reward-id="3"><div class="reward-header"><span class="reward-title">Video Game Time</span><span class="reward-exp">300 EXP</span></div><p class="reward-description">One hour of gaming</p><div class="reward-progress"><div class="progress-bar reward-progress-bar"><div class="progress-fill" style="width: 100%"></div></div><span class="progress-text">300 / 300</span></div><div class="reward-actions"><button class="claim-btn claimed" disabled>✨ CLAIMED ✨</button></div></div></div></details>
