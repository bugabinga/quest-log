<div id="auth-modal" class="auth-modal" data-signals="{&quot;loginError&quot;:null,&quot;isRateLimited&quot;:false,&quot;_password&quot;:&quot;&quot;,&quot;_loginLoading&quot;:false}"><div class="auth-backdrop"><div class="auth-container"><div class="auth-header"><h2>🗝️ Guild Entrance</h2><p>Enter your credentials to access the editor</p></div><div class="auth-error" data-show="!!$loginError"><p data-text="$loginError"></p></div><form id="login-form" class="auth-form" method="post" data-on:submit__prevent="($_password ?? '') &amp;&amp; ($_password ?? '').trim() !== '' ? @post('/editor/login', {contentType: 'form'}) : ($loginError = 'Please enter a password')"><div class="form-group"><label for="password">Master Key</label><input type="password" id="password" name="password" placeholder="Enter your master key..." data-bind="_password" autocomplete="current-password"></div><button type="submit" class="auth-submit" data-indicator="_loginLoading" data-attr:disabled="$isRateLimited || $_loginLoading"><span data-show="!$_loginLoading">Enter the Guild</span><span id="login-loading" style="display: none" data-show="$_loginLoading">Authenticating...</span></button></form><div class="auth-footer"><p>Restricted access - for guild masters only</p></div></div></div></div>
