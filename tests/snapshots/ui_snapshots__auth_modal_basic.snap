<div id="auth-modal" class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-title" data-init="loginError = null; isRateLimited = false; _password = ''"><div class="auth-backdrop"><div class="auth-container"><div class="auth-header"><h2 id="auth-title">🗝️ Guild Entrance</h2><p>Enter your credentials to access the editor</p></div><div class="auth-error" data-show="!!$loginError" role="alert" aria-live="polite"><p data-text="$loginError"></p></div><form id="login-form" class="auth-form" method="post" data-on:submit__prevent="($_password ?? '') &amp;&amp; ($_password ?? '').trim() !== '' ? @post('/editor/login', {contentType: 'form'}) : (loginError = 'Please enter a password')"><div class="form-group"><label for="password">Master Key</label><input type="password" id="password" name="password" placeholder="Enter your master key..." data-bind="_password" autocomplete="current-password" autofocus aria-describedby="password-hint"></div><p id="password-hint" class="form-hint">Enter the master key to access the editor</p><button type="submit" class="auth-submit" data-indicator="#login-loading" aria-label="Login to access editor"><span>Enter the Guild</span><span id="login-loading" style="display: none">Authenticating...</span></button></form><div class="auth-footer"><p>Restricted access - for guild masters only</p></div></div></div></div>
