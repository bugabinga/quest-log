<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Highscore</title><link rel="manifest" href="/manifest.json"><link rel="icon" href="/favicon.png" type="image/png"><link rel="stylesheet" href="/style.css"><script type="module" src="/vendor/datastar.js"></script><script type="module" src="/js/app.js"></script></head><body data-weekday=""><a class="skip-link" href="#main-content">Skip to main content</a><div id="video-modal" class="video-modal" style="display: none;"><div class="video-overlay"></div><div class="video-container"><button class="video-close" data-on:click="window.closeVideoModal()">×</button><video id="intro-video" controls playsinline><source src="/video/trailer.mp4" type="video/mp4"></video></div></div><header class="game-header"><nav class="game-header-nav"><a href="/" class="nav-link"><span class="nav-icon nav-icon--sword"></span><span>Quests</span></a><a href="/bounty" class="nav-link"><span class="nav-icon nav-icon--chest"></span><span>Bounty</span></a><a href="/highscore" class="nav-link nav-link--active"><span class="nav-icon nav-icon--trophy"></span><span>Highscore</span></a><a href="/editor" class="nav-link"><span class="nav-icon nav-icon--scroll"></span><span>Editor</span></a><span class="nav-link nav-link--trailer" data-on:click="window.openVideoModal()"><span class="nav-icon nav-icon--crystal"></span><span>Trailer</span></span></nav></header><div id="app"><div id="main-content" class="container"><div class="notifications"></div><div style="display: none;"><div data-on-signal-patch="$error &amp;&amp; triggerErrorNotification($error)" data-on-signal-patch-filter="{include: /^error$/}"></div></div><h1 class="rainbow-text">🏆 Highscore 🏆</h1><div class="highscore-stats"><div class="stat-card"><span class="stat-icon">⚔️</span><span class="stat-value">0</span><span class="stat-label">Total EXP</span></div><div class="stat-card"><span class="stat-icon">✅</span><span class="stat-value">0</span><span class="stat-label">Quests Completed</span></div><div class="stat-card"><span class="stat-icon">🎁</span><span class="stat-value">0</span><span class="stat-label">Rewards Claimed</span></div><div class="stat-card"><span class="stat-icon">👑</span><span class="stat-value">0</span><span class="stat-label">Weekly Champions</span></div></div><h2>📜 Quest History</h2><div class="history-list"><p>No quest completions yet. Start completing quests to see your history!</p></div><div style="display: none;"><div data-on-signal-patch="($rewardClaimed &amp;&amp; setTimeout(() =&gt; $rewardClaimed = null, 2500))" data-on-signal-patch-filter="{include: /^rewardClaimed$/}"></div></div></div></div><div class="reward-claimed-overlay" data-show="$rewardClaimed"><h2>🎉 REWARD CLAIMED! 🎉</h2><p>Your treasure awaits!</p></div></body></html>
