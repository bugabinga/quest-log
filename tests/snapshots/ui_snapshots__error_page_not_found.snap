<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Not Found</title><link rel="manifest" href="/manifest.json"><link rel="icon" href="/favicon.png" type="image/png"><link rel="stylesheet" href="/style.css"><script type="module" src="/vendor/datastar.js"></script><script type="module" src="/js/app.js"></script></head><body data-weekday=""><a class="skip-link" href="#main-content">Skip to main content</a><div id="app"><div id="main-content" class="container"><div class="notifications"></div><div style="display: none;"><div data-on-signal-patch="$error &amp;&amp; triggerErrorNotification($error)" data-on-signal-patch-filter="{include: /^error$/}"></div></div><div class="error-message"><h1>404 - Quest Not Found</h1><p>The page you seek has vanished into the void.</p><a href="/">← Back to Quest Log</a></div><div style="display: none;"><div data-on-signal-patch="($rewardClaimed &amp;&amp; setTimeout(() =&gt; $rewardClaimed = null, 2500))" data-on-signal-patch-filter="{include: /^rewardClaimed$/}"></div></div></div></div><div class="reward-claimed-overlay" data-show="$rewardClaimed"><h2>🎉 REWARD CLAIMED! 🎉</h2><p>Your treasure awaits!</p></div></body></html>
