<details class="weekly-rewards" id="weekly-rewards" data-attr:open="$weeklyRewardsOpen ? 'true' : ''"><summary class="rewards-summary" data-on:click__prevent="$weeklyRewardsOpen = !$weeklyRewardsOpen"><span class="rewards-icon">👑</span><span class="rewards-title">Weekly Rewards</span><span class="rewards-exp">450 EXP</span><span class="weekly-champion-badge">🏅 Weekly Champion</span></summary><div class="celebration-banner"><div class="celebration-content"><span class="celebration-icon">🏆</span><span class="celebration-title">Achievement Unlocked: Weekly Champion!</span><span class="celebration-subtitle">You claimed all rewards this week!</span></div></div><div class="rewards-list"><div class="reward-card celebration-pulse" id="reward-1" data-reward-id="1"><div class="reward-header"><span class="reward-title">Pizza Party</span><span class="reward-exp">150 EXP</span></div><p class="reward-description">Order any pizza you want</p><div class="reward-progress"><div class="progress-bar reward-progress-bar"><div class="progress-fill" style="width: 100%"></div></div><span class="progress-text">150 / 150</span></div><div class="reward-actions"><button class="claim-btn claimed" disabled>✨ CLAIMED ✨</button></div></div><div class="reward-card celebration-pulse" id="reward-2" data-reward-id="2"><div class="reward-header"><span class="reward-title">Shopping Spree</span><span class="reward-exp">300 EXP</span></div><p class="reward-description">$20 credit at the item shop</p><div class="reward-progress"><div class="progress-bar reward-progress-bar"><div class="progress-fill" style="width: 100%"></div></div><span class="progress-text">300 / 300</span></div><div class="reward-actions"><button class="claim-btn claimed" disabled>✨ CLAIMED ✨</button></div></div></div></details>
